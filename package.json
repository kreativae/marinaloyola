{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "TZ=Europe/Lisbon next dev",
    "build": "TZ=Europe/Lisbon next build",
    "start": "TZ=Europe/Lisbon next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "TZ=Europe/Lisbon tsx src/db/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:admin": "tsx scripts/create-admin.ts",
    "db:init": "tsx scripts/init.ts",
    "db:deploy": "drizzle-kit push && tsx scripts/init.ts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.64.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
